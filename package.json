{
  "name": "stayintop-site",
  "version": "1.0.0",
  "private": true,
  "description": "StayInTop 个人站点",
  "scripts": {
    "build": "npm run build:css && npm run build:blog",
    "build:css": "sass --no-source-map src/css/style.scss src/css/style.css",
    "build:blog": "node build.js",
    "serve": "http-server -p 8080 -c-1"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "http-server": "^14.1.1",
    "marked": "^15.0.12",
    "sass": "^1.103.1"
  }
}
